# Optional URL of the deployed Python FastAPI analytics service (e.g. http://127.0.0.1:8000)
# Leave unset or unreachable to run in offline local-simulation mode.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base path for GitHub Pages deployment (use /AoKiraDeck/ on GitHub Pages, / locally)
VITE_BASE_PATH=/
